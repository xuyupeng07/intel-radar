# ── 访问口令（生产必填）────────────────────────────────────────────
# 设置后，所有页面 / Server Action / API 都要求登录（/login 输入口令，会话 7 天）；
# 不设置时：开发环境放行，生产环境除 /api/health 外一律拒绝（503 并提示配置）。
APP_AUTH_PASSWORD=

# ── DeepSeek 对话 / 搜索 Key（只服务端使用，不要提交；复制为 .env.local）──
DEEPSEEK_API_KEY=
# 可选：其他搜索源 Key；也可以直接在 /settings 里填写（保存在本地 SQLite）
# BOCHA_API_KEY=
# METASO_API_KEY=
# TAVILY_API_KEY=
# 可选：覆盖搜索源请求地址
# DEEPSEEK_SEARCH_URL=
# BOCHA_SEARCH_URL=
# METASO_SEARCH_URL=
# TAVILY_SEARCH_URL=
# 可选：DeepSeek 对话接口地址与默认模型（默认 https://api.deepseek.com / deepseek-flash）
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# ── 采集链路 ──────────────────────────────────────────────────────
# 可选：手动触发抓取的请求头令牌；设置后 /api/intel/ingest 需要 x-ingest-token，
# 并且可以凭它绕过登录态供脚本调用。
# INGEST_TOKEN=
# 可选：整轮采集预算（毫秒），默认 240000，范围 60000–900000
# INGEST_TIMEOUT_MS=240000
# 可选：搜索并发上限，默认 8，范围 1–16（6 条检索词 × 4 个源共 24 个请求）
# INGEST_SEARCH_CONCURRENCY=8

# ── 消息推送 ─────────────────────────────────────────────────────
# 可选：站内链接前缀。推送消息里的「查看日报」按钮用它；不配则消息里不带链接。
# 生产填 https://<你的域名>
# APP_BASE_URL=

# ── 数据 ─────────────────────────────────────────────────────────
# 可选：SQLite 文件路径，默认 .data/intel.sqlite
# DATABASE_PATH=.data/intel.sqlite
# 可选：迁移前不自动备份（默认会写 <库文件>.v<旧版本>.bak，最多保留 3 份）
# DB_BACKUP_DISABLED=1
